{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "@guildhall/agents": ["./src/agents/index.ts"],
      "@guildhall/backend-host": ["./src/backend-host/index.ts"],
      "@guildhall/benchmarks": ["./src/benchmarks/index.ts"],
      "@guildhall/compaction": ["./src/compaction/index.ts"],
      "@guildhall/config": ["./src/config/index.ts"],
      "@guildhall/corpus-map": ["./src/corpus-map/index.ts"],
      "@guildhall/core": ["./src/core/index.ts"],
      "@guildhall/engine": ["./src/engine/index.ts"],
      "@guildhall/engineering-defaults": ["./src/engineering-defaults/index.ts"],
      "@guildhall/guilds": ["./src/guilds/index.ts"],
      "@guildhall/hooks": ["./src/hooks/index.ts"],
      "@guildhall/levers": ["./src/levers/index.ts"],
      "@guildhall/levers/profiles": ["./src/levers/profiles.ts"],
      "@guildhall/memory-core": ["./src/memory-core/index.ts"],
      "@guildhall/mcp": ["./src/mcp/index.ts"],
      "@guildhall/mcp-server": ["./src/mcp-server/index.ts"],
      "@guildhall/persistence": ["./src/persistence/index.ts"],
      "@guildhall/protocol": ["./src/protocol/index.ts"],
      "@guildhall/providers": ["./src/providers/index.ts"],
      "@guildhall/runtime": ["./src/runtime/index.ts"],
      "@guildhall/runtime/effective-task": ["./src/runtime/effective-task.ts"],
      "@guildhall/runtime/owner-input-store": ["./src/runtime/owner-input-store.ts"],
      "@guildhall/runtime/project-state-boundary": ["./src/runtime/project-state-boundary.ts"],
      "@guildhall/runtime/task-transition": ["./src/runtime/task-transition.ts"],
      "@guildhall/runtime-bundle": ["./src/runtime-bundle/index.ts"],
      "@guildhall/runtime-container": ["./src/runtime-container/index.ts"],
      "@guildhall/shared": ["./src/shared/index.ts"],
      "@guildhall/sessions": ["./src/sessions/index.ts"],
      "@guildhall/skills": ["./src/skills/index.ts"],
      "@guildhall/tools": ["./src/tools/index.ts"],
      "@guildhall/web-tokens.css": ["./src/web/tokens.css"]
    }
  },
  "include": ["src"],
  "exclude": ["src/web"]
}

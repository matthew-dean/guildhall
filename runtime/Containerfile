FROM node:22-trixie-slim

LABEL org.opencontainers.image.title="Guildhall Runtime Debian"
LABEL org.opencontainers.image.description="Project-scoped Guildhall runtime image for 0.9 agent execution"
LABEL org.opencontainers.image.source="https://github.com/matthew-dean/guildhall"
LABEL org.opencontainers.image.licenses="LicenseRef-FLL-1.2"

ENV GUILDHALL_RUNTIME_OS=debian
ENV GUILDHALL_RUNTIME_DEBIAN_VERSION=13
ENV GUILDHALL_RUNTIME_DEBIAN_CODENAME=trixie
ENV GUILDHALL_RUNTIME_IMAGE_TAG=0.9.0-trixie-node22-python313-playwright
ENV GUILDHALL_PROJECT_ROOT=/workspace/project
ENV GUILDHALL_HOME=/home/guildhall/.guildhall

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    coreutils \
    curl \
    findutils \
    git \
    jq \
    openssh-client \
    pipx \
    procps \
    python3 \
    python3-venv \
    ripgrep \
    tar \
    tini \
    unzip \
    xz-utils \
  && corepack enable \
  && npx --yes playwright install-deps chromium \
  && rm -rf /var/lib/apt/lists/*

RUN if id -u guildhall >/dev/null 2>&1; then \
      usermod --home /home/guildhall --move-home --shell /bin/bash guildhall; \
    elif id -u node >/dev/null 2>&1 && [ "$(id -u node)" = "1000" ]; then \
      groupmod --new-name guildhall node; \
      usermod --login guildhall --home /home/guildhall --move-home --shell /bin/bash node; \
    else \
      useradd --create-home --shell /bin/bash --uid 1000 guildhall; \
    fi \
  && mkdir -p /workspace/project /home/guildhall/.guildhall \
  && chown -R guildhall:guildhall /workspace /home/guildhall/.guildhall

COPY runtime/bin/guildhall-runtime /usr/local/bin/guildhall-runtime
COPY runtime/bin/guildhall-exec /usr/local/bin/guildhall-exec
COPY runtime/bin/guildhall-healthcheck /usr/local/bin/guildhall-healthcheck
COPY runtime/bin/guildhall-capability-request /usr/local/bin/guildhall-capability-request
COPY runtime/bin/guildhall-runtime-info /usr/local/bin/guildhall-runtime-info

RUN chmod +x \
  /usr/local/bin/guildhall-runtime \
  /usr/local/bin/guildhall-exec \
  /usr/local/bin/guildhall-healthcheck \
  /usr/local/bin/guildhall-capability-request \
  /usr/local/bin/guildhall-runtime-info

USER guildhall
WORKDIR /workspace/project
VOLUME ["/workspace/project", "/home/guildhall/.guildhall"]

ENTRYPOINT ["guildhall-runtime"]

{
  "name": "guildhall",
  "version": "0.13.2",
  "description": "A general-purpose multi-agent operating system for software projects.",
  "license": "LicenseRef-FLL-1.2",
  "licenses": [
    {
      "type": "LicenseRef-FLL-1.2",
      "url": "https://fllicense.org"
    }
  ],
  "type": "module",
  "bin": {
    "guildhall": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:ui && node ./build.mjs",
    "build:ui": "pnpm --filter @guildhall/ui build",
    "build:macos-package": "node ./scripts/build-macos-package.mjs",
    "dev": "node ./build.mjs --watch",
    "dev:install": "node ./scripts/dev-install.mjs",
    "dev:uninstall": "node ./scripts/dev-uninstall.mjs",
    "dev:hermes:install": "node ./scripts/install-hermes-dev.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && pnpm typecheck:ui",
    "typecheck:ui": "pnpm --filter @guildhall/ui typecheck",
    "test": "vitest run",
    "test:release": "vitest run scripts/release-artifacts.test.ts scripts/release-documentation.test.ts scripts/publish-script.test.ts scripts/pr-workflow.test.ts scripts/narrative-harness-release-proof.test.ts scripts/browser-route-proof.test.ts src/runtime/__tests__/release-manifest.test.ts src/runtime/__tests__/release-proof-matrix.test.ts src/runtime/__tests__/project-summary-projection.test.ts src/runtime/__tests__/project-state-boundary.test.ts src/runtime/__tests__/project-scope-projection.test.ts src/runtime/__tests__/serve-release-readiness.test.ts src/runtime/__tests__/proof-health.test.ts src/runtime/__tests__/git-story.test.ts src/persistence/__tests__/file-backed.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:90": "vitest run --coverage --config vitest.coverage-90.config.ts",
    "test:ui": "pnpm build && playwright test",
    "test:ui:install": "playwright install chromium",
    "lint:deps": "depcruise src",
    "lint:design": "node scripts/design-token-audit.mjs",
    "lint:contracts": "node scripts/contract-touch-detector.mjs",
    "lint:data-layer": "node scripts/data-layer-guardrails.mjs",
    "lint:reductions": "node scripts/reduction-guardrails.mjs",
    "audit:project-spine": "node scripts/project-orientation-spine-audit.mjs",
    "audit:project-state-performance": "node scripts/project-state-performance-audit.mjs",
    "audit:project-state-agreement": "node scripts/project-state-agreement-audit.mjs",
    "clean": "rm -rf dist",
    "release": "node scripts/publish.mjs minor",
    "release:dry": "node scripts/publish.mjs minor --dry-run --allow-branch",
    "runtime:image:build": "node scripts/runtime-image-build.mjs",
    "runtime:image:smoke": "node scripts/runtime-image-smoke.mjs",
    "benchmarks:smoke": "pnpm build && node dist/cli.js benchmarks run lifecycle --fixture-set smoke --automation fully-automated && node dist/cli.js benchmarks run tblite --subset smoke --automation fully-automated && node dist/cli.js benchmarks run swe-local --subset smoke --automation fully-automated",
    "benchmarks:compare:hermes": "pnpm build && node dist/cli.js benchmarks compare hermes --hermes-root .guildhall/dev-tools/hermes-agent",
    "benchmarks:compare:hermes-quality": "pnpm build && node scripts/compare-hermes-quality.mjs",
    "benchmarks:compare:hermes-app-explicit": "pnpm build && node scripts/compare-hermes-quality.mjs --mode app-explicit",
    "benchmarks:compare:hermes-app-infer": "pnpm build && node scripts/compare-hermes-quality.mjs --mode app-infer",
    "smoke:release": "node scripts/release-smoke.mjs",
    "audit:release-acceptance": "node scripts/release-acceptance-audit.mjs",
    "model:bakeoff": "node scripts/model-bakeoff.mjs",
    "model:independence": "node scripts/model-independence-audit.mjs && pnpm exec vitest run src/runtime/__tests__/model-independence.test.ts src/runtime/__tests__/effective-memory-packet.test.ts src/runtime/__tests__/design-feedback.test.ts src/runtime/__tests__/proof-paths.test.ts src/runtime/__tests__/context-builder.test.ts src/skills/__tests__/skills.test.ts --reporter=dot",
    "docs:prepare-versions": "node scripts/prepare-versioned-docs.mjs",
    "docs:check-copy": "node scripts/check-public-copy-voice.mjs",
    "docs:extract-help": "pnpm docs:prepare-versions && node scripts/extract-help-topics.mjs",
    "docs:check-help-sync": "node scripts/check-help-sync.mjs",
    "docs:check-release": "node scripts/check-release-documentation.mjs",
    "docs:dev": "npm run docs:extract-help && vitepress dev docs",
    "docs:build": "npm run docs:check-copy && npm run docs:extract-help && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "memory:migrate": "node scripts/migrations/0.8.0-project-state.mjs",
    "migrate:project-state": "node scripts/migrations/0.13.0-project-state-finalize.mjs",
    "memory:mastra:audit": "pnpm build && node dist/cli.js memory mastra-audit",
    "memory:mastra:value-gate": "node scripts/prototype-mastra-memory-value-gate.mjs",
    "service:install": "node ./scripts/install-launch-agent.mjs",
    "service:uninstall": "node ./scripts/uninstall-launch-agent.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@inquirer/prompts": "^7.4.0",
    "@mastra/core": "^1.41.0",
    "@mastra/libsql": "^1.12.1",
    "@mastra/memory": "^1.20.2",
    "@modelcontextprotocol/sdk": "^1.19.0",
    "hono": "^4.7.7",
    "js-yaml": "^4.1.0",
    "lucide-svelte": "~1.0.1",
    "marked": "~18.0.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.60.0",
    "@sveltejs/adapter-static": "~3.0.10",
    "@sveltejs/kit": "~2.65.1",
    "@sveltejs/vite-plugin-svelte": "~6.2.4",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/svelte": "~5.3.1",
    "@testing-library/user-event": "~14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitest/coverage-v8": "^3.1.1",
    "dependency-cruiser": "^16.8.0",
    "esbuild": "^0.24.0",
    "esbuild-svelte": "~0.9.4",
    "happy-dom": "~20.9.0",
    "svelte": "~5.55.4",
    "svelte-preprocess": "~6.0.3",
    "typescript": "^5.9.3",
    "vite": "~7.3.2",
    "vitepress": "^1.5.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "orchestration",
    "llm",
    "ai"
  ]
}

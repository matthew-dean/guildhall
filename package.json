{
  "name": "guildhall",
  "version": "0.6.0",
  "description": "A general-purpose multi-agent operating system for software projects.",
  "license": "LicenseRef-FLL-1.2",
  "licenses": [
    {
      "type": "LicenseRef-FLL-1.2",
      "url": "https://fllicense.org"
    }
  ],
  "type": "module",
  "bin": {
    "guildhall": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:ui && node ./build.mjs",
    "build:ui": "pnpm --filter @guildhall/ui build",
    "build:macos-package": "node ./scripts/build-macos-package.mjs",
    "dev": "node ./build.mjs --watch",
    "dev:install": "node ./scripts/dev-install.mjs",
    "dev:uninstall": "node ./scripts/dev-uninstall.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && pnpm typecheck:ui",
    "typecheck:ui": "pnpm --filter @guildhall/ui typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:90": "vitest run --coverage --config vitest.coverage-90.config.ts",
    "test:ui": "pnpm build && playwright test",
    "test:ui:install": "playwright install chromium",
    "lint:deps": "depcruise src",
    "clean": "rm -rf dist",
    "release": "node scripts/publish.mjs",
    "release:dry": "node scripts/publish.mjs --dry-run",
    "model:bakeoff": "node scripts/model-bakeoff.mjs",
    "docs:prepare-versions": "node scripts/prepare-versioned-docs.mjs",
    "docs:extract-help": "pnpm docs:prepare-versions && node scripts/extract-help-topics.mjs",
    "docs:check-help-sync": "node scripts/check-help-sync.mjs",
    "docs:dev": "npm run docs:extract-help && vitepress dev docs",
    "docs:build": "npm run docs:extract-help && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "service:install": "node ./scripts/install-launch-agent.mjs",
    "service:uninstall": "node ./scripts/uninstall-launch-agent.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@inquirer/prompts": "^7.4.0",
    "@modelcontextprotocol/sdk": "^1.19.0",
    "hono": "^4.7.7",
    "js-yaml": "^4.1.0",
    "lucide-svelte": "~1.0.1",
    "marked": "~18.0.2",
    "svelte-sonner": "~1.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.60.0",
    "@sveltejs/vite-plugin-svelte": "~6.2.4",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/svelte": "~5.3.1",
    "@testing-library/user-event": "~14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitest/coverage-v8": "^3.1.1",
    "dependency-cruiser": "^16.8.0",
    "esbuild": "^0.24.0",
    "esbuild-svelte": "~0.9.4",
    "happy-dom": "~20.9.0",
    "svelte": "~5.55.4",
    "svelte-preprocess": "~6.0.3",
    "typescript": "^5.9.3",
    "vitepress": "^1.5.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "orchestration",
    "llm",
    "ai"
  ]
}
